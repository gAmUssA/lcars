{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "LCARS",
  "Version": "0.1.1.0",
  "Author": "Viktor Gamov",
  "Description": "Herdr coding agents across every host on your Stream Deck, fed by the Ops daemon.",
  "Category": "LCARS",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/marketplace",
  "URL": "https://github.com/gAmUssA/lcars",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "UUID": "io.gamov.lcars",
  "Actions": [
    {
      "Name": "Inbox Key",
      "UUID": "io.gamov.lcars.inbox",
      "Icon": "imgs/actions/inbox/icon",
      "Tooltip": "One Herdr agent pane (by slot). Colour is its state; tap focuses the pane.",
      "PropertyInspectorPath": "ui/inbox-key.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/inbox/key",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Workspace Key",
      "UUID": "io.gamov.lcars.workspace",
      "Icon": "imgs/actions/workspace/icon",
      "Tooltip": "One Herdr workspace (by slot): colour is its agents' state, press switches that host's Herdr to it.",
      "PropertyInspectorPath": "ui/workspace-key.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/workspace/icon",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Scroll Dial",
      "UUID": "io.gamov.lcars.dial.scroll",
      "Icon": "imgs/actions/dial-scroll/icon",
      "Tooltip": "Pages the Inbox Keys when there are more agents than keys. Press returns to page 1.",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "StackColor": "#F0A030",
        "TriggerDescription": {
          "Rotate": "Page the agent list",
          "Push": "Back to page 1",
          "Touch": "Filter by host"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/dial-scroll/icon"
        }
      ]
    },
    {
      "Name": "Machine Dial",
      "UUID": "io.gamov.lcars.dial.machine",
      "Icon": "imgs/actions/dial-machine/icon",
      "Tooltip": "Cycles the host filter: all hosts, then each host in turn. Press shows all hosts.",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "StackColor": "#9A7BD0",
        "TriggerDescription": {
          "Rotate": "Cycle host filter",
          "Push": "Show all hosts",
          "Touch": "Filter by host"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/dial-machine/icon"
        }
      ]
    },
    {
      "Name": "Effort Dial",
      "UUID": "io.gamov.lcars.dial.effort",
      "Icon": "imgs/actions/dial-effort/icon",
      "Tooltip": "Picks a Claude Code reasoning effort; press sends /effort <level> to the focused Claude pane.",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "StackColor": "#5AA0E0",
        "TriggerDescription": {
          "Rotate": "Pick effort level",
          "Push": "Send /effort to focused Claude",
          "Touch": "Filter by host"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/dial-effort/icon"
        }
      ]
    },
    {
      "Name": "Pane Dial",
      "UUID": "io.gamov.lcars.dial.pane",
      "Icon": "imgs/actions/dial-pane/icon",
      "Tooltip": "Scrolls the focused pane's terminal. Press toggles the strip between the fleet bar and the inbox ticker; in ticker mode the dial cycles blocked agents.",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "StackColor": "#D13438",
        "TriggerDescription": {
          "Rotate": "Scroll focused pane / cycle blocked agents",
          "Push": "Toggle fleet bar / inbox ticker",
          "Touch": "Focus the blocked agent"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/dial-pane/icon"
        }
      ]
    },
    {
      "Name": "Attach",
      "UUID": "io.gamov.lcars.attach",
      "Icon": "imgs/actions/attach/icon",
      "Tooltip": "Opens an iTerm2 window attached to a host's Herdr (ssh, mosh, or tmux).",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/attach/icon",
          "TitleAlignment": "bottom"
        }
      ],
      "PropertyInspectorPath": "ui/attach.html"
    },
    {
      "Name": "Stop All",
      "UUID": "io.gamov.lcars.stop-all",
      "Icon": "imgs/actions/stop-all/icon",
      "Tooltip": "Press twice within 4 s to send Escape to every working or blocked agent.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/stop-all/icon",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Dictate",
      "UUID": "io.gamov.lcars.dictate",
      "Icon": "imgs/actions/dictate/icon",
      "Tooltip": "Raises iTerm2 and starts macOS dictation.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/dictate/icon",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Mute Bell",
      "UUID": "io.gamov.lcars.mute-bell",
      "Icon": "imgs/actions/mute-bell/icon",
      "Tooltip": "Toggles the done-ping sound.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/mute-bell/icon",
          "TitleAlignment": "bottom"
        }
      ]
    }
  ]
}
